 CORE = str(ROOT / config["execution"].get("core_python", "envs/core-venv/bin/python"))
 WMH_PYTHON = str(ROOT / config["execution"].get("wmh_python", "envs/wmh/bin/python"))
 T1_PYTHON = str(ROOT / config["execution"].get("t1_python", "envs/t1/bin/python"))
@@ -98,10 +140,50 @@ rule audit:
         "PYTHONPATH={ROOT}/src {CORE} -m substain_features.cli audit --config-file {CONFIG_FILE} --participant-id {SELECTED}"
 
 
