+    ROLLING_ADMISSION_INPUT = []
+    ROLLING_COMPLETE = ""
+
 
 def input_path(value):
     path = Path(value)
@@ -54,6 +89,13 @@ def stage_pattern(stage):
     return str(DERIVATIVES / "sub-{participant}" / "status" / "{}.json".format(stage))
 
 
