+def _peak_rss_mb(who: int) -> Optional[float]:
+    """读取Unix进程峰值RSS；不支持的平台返回None。"""
+
+    if resource is None:
+        return None
+    usage = resource.getrusage(who)
+    divisor = 1024.0 * 1024.0 if sys.platform == "darwin" else 1024.0
+    return round(float(usage.ru_maxrss) / divisor, 3)
+
